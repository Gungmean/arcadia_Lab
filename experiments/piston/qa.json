 ["eval","if(Math.abs(pistonLab.state.W-40)>.01||Math.abs(pistonLab.state.dU-60)>.01)throw Error('free heat work split');'free Q100: U60 + W40'"],
 ["shot","tmp/piston-free.png",".wrap",1],
 ["lines","tmp/piston-free-lines.png",".figure"],
 ["click","[data-mode=locked]"],
 ["eval","if(pistonLab.progress!==0)throw Error('mode switch must reset');'new mode resets path'"],
 ["click","#finish"],
 ["until","pistonLab.progress>.99999",4000],
 ["eval","if(Math.abs(pistonLab.state.W)>.001||Math.abs(pistonLab.state.dU-100)>.01)throw Error('locked conservation');'locked Q100: U100 W0'"],
 ["shot","tmp/piston-locked.png",".figure",2],
