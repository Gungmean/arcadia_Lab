[
 ["wait",200],
 ["eval","document.querySelector('#search2d').value='현미경';document.querySelector('#search2d').dispatchEvent(new Event('input',{bubbles:true}));'search microscopy'"],
 ["eval","(()=>{const c=document.querySelector('a[href*=microscopy]'),s=getComputedStyle(c),p=getComputedStyle(c.querySelector('p'));if(c.classList.contains('hidden'))throw Error('new experiment not searchable');return{visible:true,shadow:s.boxShadow,paragraphDisplay:p.display,text:getComputedStyle(c.querySelector('h2')).color,background:getComputedStyle(document.body).backgroundColor};})()"],
 ["shot","prototypes/microscopy-lab/shots/arcadia-menu.png",".container",1],
 ["click","a[href*=microscopy]"],
 ["until","typeof microscopyLab!=='undefined'",10000],
 ["eval","if(microscopyLab.mode!=='tem')throw Error('menu must enter TEM');'menu opens production TEM'"],
 ["click","[data-lesson=thick]"],
 ["eval","if(microscopyLab.state.thickness!==200||microscopyLab.step!==2)throw Error('TEM thick lesson');'TEM lesson applies single condition'"],
 ["click","[data-lesson=aperture]"],
 ["eval","if(microscopyLab.state.aperture!==.25||microscopyLab.state.thickness!==70)throw Error('lesson did not reset reference');'TEM aperture compares against reference'"],
 ["shot","prototypes/microscopy-lab/shots/production-tem.png",".workspace",1],
 ["click","#tab-sem"],
 ["click","[data-lesson=bse]"],
 ["eval","if(microscopyLab.state.detector!=='BSE')throw Error('BSE lesson');'BSE lesson OK'"],
 ["click","[data-lesson=charging]"],
 ["eval","if(microscopyLab.state.coating||microscopyLab.state.detector!=='SE')throw Error('coating comparison');'charging lesson OK'"],
 ["click","[data-lesson=dwell]"],
 ["eval","if(microscopyLab.state.dwell!==20||!microscopyLab.state.coating||Math.abs(microscopyLab.measure().frameTime-5.24288)>.00001)throw Error('long dwell lesson');'dwell lesson and reset OK'"],
 ["shot","prototypes/microscopy-lab/shots/production-sem.png",".workspace",1],
 ["eval","if(document.documentElement.scrollWidth>innerWidth)throw Error('horizontal overflow');'layout fits'"],
 ["click",".lab-return"],
 ["until","!!document.querySelector('#experimentGrid')",10000],
 ["eval","if(!document.querySelector('#experimentGrid'))throw Error('return to menu failed');'roundtrip navigation OK'"]
]
